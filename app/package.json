{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output src/test-utils/test-schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "deploy:teste": "vercel",
    "deploy:prod": "vercel --prod --yes",
    "db:ensaio": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "backup:provar": "node scripts/verificar-backup.mjs",
    "backup:restaurar": "node --env-file=.env.restore scripts/restore.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@types/pg": "^8.20.0",
    "@types/react-signature-canvas": "^1.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "next-intl": "^4.13.5",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "react-leaflet": "^5.0.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "resend": "^6.16.0",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pglite-prisma-adapter": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
