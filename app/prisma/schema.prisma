generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (empresa que contrata o SaaS) ────────────────────────────────────

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  document           String?
  logoUrl            String?
  phone              String?
  website            String?
  address            String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  planId             String?
  asaasCustomerId    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users             User[]
  clients           Client[]
  orders            ServiceOrder[]
  expenses          Expense[]
  revenues          Revenue[]
  providers         Provider[]
  maintenanceOrders MaintenanceOrder[]
  tabPermissions    TabPermission[]
  quotes            Quote[]
  plan              Plan?              @relation(fields: [planId], references: [id])
  subscriptions     Subscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  priceMonthly  Decimal  @db.Decimal(10, 2)
  priceYearly   Decimal  @db.Decimal(10, 2)
  maxUsers      Int?
  features      String[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenants       Tenant[]
  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  tenantId       String
  planId         String
  asaasId        String?
  status         SubscriptionStatus @default(TRIAL)
  billingCycle   BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id
  name      String
  email     String
  role      UserRole @default(TECHNICIAN)
  tenantId  String
  document  String?
  phone     String?
  createdAt DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  serviceOrders     ServiceOrder[]
  location          UserLocation?
  pushSubscriptions PushSubscription[]
  userAddress       UserAddress?
}

model UserAddress {
  id         String  @id @default(cuid())
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?
  userId     String  @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Client {
  id        String       @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  status    ClientStatus @default(ACTIVE)
  tenantId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  address       Address?
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  serviceOrders ServiceOrder[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DEFAULTER
}

model Address {
  id         String  @id @default(cuid())
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?
  latitude   Float?
  longitude  Float?
  clientId   String  @unique

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── Ordem de Serviço ─────────────────────────────────────────────────────────

model ServiceOrder {
  id             String        @id @default(cuid())
  number         Int
  title          String
  description    String?
  conclusionNote String?
  status         ServiceStatus @default(OPEN)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  clientId       String
  tenantId       String
  technicianId   String?
  scheduledAt    DateTime?
  concludedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id])
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  technician  User?         @relation(fields: [technicianId], references: [id])
  items       ServiceItem[]
  attachments Attachment[]
  revenues    Revenue[]

  @@unique([tenantId, number])
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  DONE
  INVOICED
  CANCELLED
}

model ServiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  orderId     String

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  orderId   String
  createdAt DateTime @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── Financeiro ───────────────────────────────────────────────────────────────

model Revenue {
  id          String        @id @default(cuid())
  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus @default(PENDING)
  tenantId    String
  orderId     String?
  createdAt   DateTime      @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  ServiceOrder? @relation(fields: [orderId], references: [id])
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus   @default(PENDING)
  category    ExpenseCategory @default(OTHER)
  tenantId    String
  recurring   Boolean         @default(false)
  createdAt   DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  FIXED
  VARIABLE
  OTHER
}

// ─── Prestadores de Serviço ───────────────────────────────────────────────────

model Provider {
  id        String   @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  specialty String?
  notes     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  maintenanceOrders MaintenanceOrder[]
}

// ─── Ordem de Manutenção Interna ──────────────────────────────────────────────

model MaintenanceOrder {
  id          String            @id @default(cuid())
  number      Int
  title       String
  description String?
  status      MaintenanceStatus @default(OPEN)
  totalAmount Decimal           @default(0) @db.Decimal(12, 2)
  tenantId    String
  providerId  String?
  scheduledAt DateTime?
  concludedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  provider Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  items    MaintenanceItem[]

  @@unique([tenantId, number])
}

model MaintenanceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  orderId     String

  order MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─── Orçamentos ───────────────────────────────────────────────────────────────

model Quote {
  id            String      @id @default(cuid())
  number        Int
  clientName    String
  clientAddress String?
  clientContact String?
  description   String
  materials     String?
  amount        Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime?
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

// ─── Controle de Acesso ───────────────────────────────────────────────────────

model TabPermission {
  id       String   @id @default(cuid())
  tenantId String
  role     UserRole
  tab      String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, tab])
}

// ─── Notificações Push ────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

// ─── Localização GPS ──────────────────────────────────────────────────────────

model UserLocation {
  id        String   @id @default(cuid())
  userId    String   @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
