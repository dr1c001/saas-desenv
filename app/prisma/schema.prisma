generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (empresa que contrata o SaaS) ────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  document  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  clients  Client[]
  orders   ServiceOrder[]
  expenses Expense[]
  revenues Revenue[]
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model User {
  id       String   @id
  name     String
  email    String
  role     UserRole @default(TECHNICIAN)
  tenantId String
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  serviceOrders ServiceOrder[]
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Client {
  id        String       @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  status    ClientStatus @default(ACTIVE)
  tenantId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  address       Address?
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  serviceOrders ServiceOrder[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DEFAULTER
}

model Address {
  id         String  @id @default(cuid())
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?
  clientId   String  @unique

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── Ordem de Serviço ─────────────────────────────────────────────────────────

model ServiceOrder {
  id           String        @id @default(cuid())
  number       Int
  title        String
  description  String?
  status       ServiceStatus @default(OPEN)
  totalAmount  Decimal       @default(0) @db.Decimal(12, 2)
  clientId     String
  tenantId     String
  technicianId String?
  scheduledAt  DateTime?
  concludedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id])
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  technician  User?         @relation(fields: [technicianId], references: [id])
  items       ServiceItem[]
  attachments Attachment[]
  revenues    Revenue[]

  @@unique([tenantId, number])
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  DONE
  INVOICED
  CANCELLED
}

model ServiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  orderId     String

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  orderId   String
  createdAt DateTime @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── Financeiro ───────────────────────────────────────────────────────────────

model Revenue {
  id          String        @id @default(cuid())
  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus @default(PENDING)
  tenantId    String
  orderId     String?
  createdAt   DateTime      @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  ServiceOrder? @relation(fields: [orderId], references: [id])
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus   @default(PENDING)
  category    ExpenseCategory @default(OTHER)
  tenantId    String
  recurring   Boolean         @default(false)
  createdAt   DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  FIXED
  VARIABLE
  OTHER
}
