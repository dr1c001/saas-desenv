generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (empresa que contrata o SaaS) ────────────────────────────────────

// ─── Sobre os índices (@@index) ───────────────────────────────────────────────
//
// Até 10/08/2026 o schema não tinha NENHUM @@index — só chaves primárias e 13
// @unique. Com 12 OS em produção isso é invisível; o problema é que cresce
// junto com o banco e fica mais caro de corrigir a cada dia.
//
// Dois fatos motivam a lista abaixo:
//
//  1. Toda consulta do produto é multi-tenant: `WHERE tenantId = ?` seguido,
//     quase sempre, de `[+ status] ORDER BY createdAt DESC`. Sem índice
//     composto, o Postgres varre a tabela inteira de TODOS os tenants e
//     descarta o que não é do tenant atual. Client, Revenue e Expense não
//     tinham nem cobertura parcial. Índice em (tenantId, createdAt) resolve
//     filtro e ordenação de uma vez.
//
//  2. O Postgres NÃO cria índice em chave estrangeira automaticamente (ao
//     contrário do MySQL). Sem isso, todo JOIN varre a tabela, e todo DELETE
//     em cascata (apagar um cliente, uma OS) varre cada tabela filha.
//
// Escolhi por consulta real do código, não por precaução: cada índice abaixo
// corresponde a um `where`/`orderBy` que existe hoje em actions/ ou app/.
// Índice não é de graça — pesa em cada INSERT/UPDATE e ocupa disco.

model Tenant {
  id                      String             @id @default(cuid())
  name                    String
  document                String?
  logoUrl                 String?
  phone                   String?
  website                 String?
  address                 String?
  subscriptionStatus      SubscriptionStatus @default(TRIAL)
  trialEndsAt             DateTime?
  planId                  String?
  asaasCustomerId         String?
  nfeioCompanyId          String?
  fiscalCnpj              String?
  fiscalMunicipalCode     String?
  fiscalCityName          String?
  fiscalStateCode         String?
  fiscalIssRate           Float?
  zapiInstance            String?
  zapiToken               String?
  referralCode            String?            @unique
  referredByCode          String?
  referralDiscountPercent Int                @default(0)
  // Recursos liberados ALÉM do que o plano dá. Existe por um motivo concreto:
  // quando as travas de plano foram ligadas (10/08/2026), a primeira cliente
  // pagante já usava assinatura digital no Starter — recurso que a tela vende
  // como Pro. Tirar da mão de quem já paga e já usa custa mais que a receita
  // do upgrade, então ela foi mantida por aqui. Clientes novos seguem a regra.
  // Ver lib/plan.ts.
  extraFeatures           String[]           @default([])
  locale                  Locale             @default(pt)

  /// Separam "nunca mexeram nisso" de "mexeram e nao liberaram nada".
  /// Sem esses sinais a lista vazia tem dois significados opostos e o sistema
  /// escolhe o errado — desmarcar tudo na tela devolvia o PADRAO. Era o caso
  /// real da permissao por aba: desmarcar as 19 abas concedia 3.
  tabsConfigured          Boolean            @default(false)
  actionsConfigured       Boolean            @default(false)
  /// QUAIS cargos ja foram configurados. Substitui os booleanos acima, que
  /// serviam quando so o tecnico era configuravel: com varios cargos, um
  /// booleano da empresa inteira faria configurar o tecnico deixar o
  /// financeiro com menu vazio. Regra em lib/cargos.ts.
  tabsConfiguredRoles     String[]           @default([])
  actionsConfiguredRoles  String[]           @default([])

  /// Tetos ajustados PARA ESTA EMPRESA, por cima do que o plano da.
  ///
  /// NULL = herda do plano · 0 = SEM LIMITE · outro numero = o teto dela.
  ///
  /// Os dois primeiros seriam o mesmo `null` num campo comum, e sao coisas
  /// diferentes: "herdar" acompanha o plano quando ele mudar, "sem limite" nao.
  /// Zero carrega o sentido de ilimitado porque zero usuario, zero OS ou zero
  /// nota nao significa nada como teto real. Regra em lib/limite.ts.
  ///
  /// Existem porque os planos sao tres e as empresas nao: sempre aparece a que
  /// precisa de 12 usuarios mas nao quer o Enterprise.
  /// Funcoes DESLIGADAS para esta empresa. Catalogo em lib/funcoes.ts.
  ///
  /// Lista de desligadas, e nao de ligadas, de proposito: vazia significa
  /// "tudo funcionando", que e o comportamento de hoje. Nenhuma empresa muda no
  /// dia em que a chave passa a existir — e essa e a unica forma segura de
  /// criar interruptor para coisa que ja esta em uso. Uma lista de "ligadas"
  /// comecaria vazia e apagaria o sistema inteiro de todo mundo.
  ///
  /// Oposto de extraFeatures, que lista o que foi CONCEDIDO alem do plano.
  disabledFeatures        String[]           @default([])

  maxUsersOverride        Int?
  maxOrdersOverride       Int?
  maxNfseOverride         Int?

  /// Franquia mensal de comandos da assistente de voz.
  ///
  /// NULL herda IA_COMANDOS_PADRAO (lib/recursos.ts), e nao um teto de plano:
  /// a assistente e ADICIONAL, nenhum plano a inclui. Sem esse padrao,
  /// conceder o adicional daria "liberado, com zero comandos".
  /// Taxa de visita: o que a empresa cobra pelo deslocamento quando o
  /// orcamento sai do local e o cliente RECUSA. Regra em lib/os-orcamento.ts.
  ///
  /// NULL/0 = nao cobra, e e o padrao. Umas empresas cobram (combustivel e
  /// duas horas do tecnico foram gastos), outras absorvem como custo de
  /// vender — o sistema nao escolhe por elas.
  visitFee                Decimal?           @db.Decimal(10, 2)

  /// Quanto a empresa tinha em caixa/banco no dia em que comecou a usar o
  /// sistema. Sem isso o caixa do balanco e so o MOVIMENTO desde entao, e uma
  /// empresa que ja existia aparece com caixa negativo no primeiro mes em que
  /// paga mais do que recebe. Regra em lib/balanco.ts.
  ///
  /// NULL = nao informou, que e diferente de zero informado — o conferente
  /// (lib/contador-agente.ts) usa essa diferenca para escolher a mensagem.
  openingCash             Decimal?           @db.Decimal(12, 2)

  /// O que os socios puseram na empresa. Sem ele, TODO o patrimonio liquido
  /// aparece como resultado acumulado, como se a empresa tivesse nascido do
  /// nada e lucrado tudo — e e a primeira pergunta que o contador faz.
  shareCapital            Decimal?           @db.Decimal(12, 2)

  maxIaOverride           Int?
  /// Quantos comandos ja foram gastos no mes corrente.
  iaComandosNoMes         Int                @default(0)
  /// AAAA-MM (fuso de Brasilia) a que o contador se refere. Texto, e nao data:
  /// comparar "2026-08" com "2026-08" nao tem fuso para errar.
  iaMesDoContador         String?

  /// Mensalidade combinada com esta empresa, quando difere da do plano.
  /// NULL = cobra o preco do plano. Serve ao plano customizado: recursos e
  /// tetos proprios pedem preco proprio.
  customPriceMonthly      Decimal?           @db.Decimal(10, 2)

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  users             User[]
  clients           Client[]
  equipments        Equipment[]
  orders            ServiceOrder[]
  expenses          Expense[]
  revenues          Revenue[]
  providers         Provider[]
  maintenanceOrders MaintenanceOrder[]
  tabPermissions    TabPermission[]
  actionPermissions ActionPermission[]
  branches          Branch[]
  apiKeys           ApiKey[]
  fiscalCertificate FiscalCertificate?
  quotes            Quote[]
  plan              Plan?              @relation(fields: [planId], references: [id])
  subscriptions     Subscription[]
  customFields      CustomField[]
  contracts         ServiceContract[]
  stockLocations    StockLocation[]
  quotations        Quotation[]
  assets            Asset[]
  balanceEntries    BalanceEntry[]
  supportThreads    SupportThread[]

  // Vocabulario adaptavel: como a empresa chama OS e tecnico.
  // Formato em lib/vocabulario.ts. Fica junto do locale porque e lido no mesmo
  // ponto (i18n/request.ts) e na mesma consulta — zero query extra.
  vocabulary Json? @db.JsonB

  /// Aviso automatico ao cliente final. Formato em lib/aviso-cliente.ts.
  /// Nasce NULL de proposito: sem configuracao, nada e enviado. Mandar
  /// mensagem no celular do cliente final de outra empresa nao e decisao
  /// que o sistema toma por ela.
  clientNotifications Json? @db.JsonB

  /// Regua de cobranca das contas a receber DA EMPRESA. Formato em
  /// lib/regua-cobranca.ts. Nasce NULL pela mesma razao acima, e em coluna
  /// SEPARADA de propósito: avisar que o tecnico esta a caminho e cobrar uma
  /// conta atrasada sao dois consentimentos diferentes, e num JSON so ligar
  /// um ligaria o outro.
  dunningConfig Json? @db.JsonB

  /// Termos que a empresa escreve e que saem impressos nos documentos.
  /// Garantia, condicoes, prazo, foro — o que ela achar necessario pro
  /// ramo dela. Separados porque garantia (OS) e validade/pagamento
  /// (orcamento) sao textos diferentes na vida real.
  /// Prazo de garantia PADRAO, em dias, escolhido pela empresa. Cada OS pode
  /// ter o seu proprio — servicos diferentes tem garantias diferentes.
  warrantyDays Int?

  orderTerms String? @db.Text
  quoteTerms String? @db.Text

  /// Cobranca do cliente final por PIX. A empresa usa a conta que ja tem —
  /// nao exigimos conta em gateway nenhum. O codigo e montado localmente
  /// (lib/pix.ts), entao nao ha API, nem chave secreta, nem intermediario:
  /// o dinheiro vai direto do cliente final pra empresa e o ServicoOS nunca
  /// toca nele.
  pixKey      String?
  pixKeyType  String?
  /// Nome e cidade de quem recebe, como saem no app do banco do pagador.
  /// Guardados a parte do nome/cidade do tenant porque o padrao limita a
  /// 25 e 15 caracteres e o titular da conta pode ser outro (o socio, por
  /// exemplo) — quem nao confere isso gera codigo que o banco recusa.
  pixReceiver String?
  pixCity     String?

  /// Quando a empresa fechou o painel de primeiros passos na mao.
  ///
  /// Data, e nao booleano, porque a pergunta que aparece depois nao e "fechou?"
  /// e sim "ha quanto tempo" — util pra entender abandono no inicio, que e
  /// justamente o que esse painel existe pra combater. Nulo = nunca fechou; o
  /// painel some sozinho quando todos os passos ficam prontos (ver
  /// lib/primeiros-passos.ts), entao isto so registra a saida antecipada.
  onboardingDismissedAt DateTime?
  suppliers             Supplier[]
  parts                 Part[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  orderEvents           OrderEvent[]
  offlineOperations     OfflineOperation[]
}

// Idioma da empresa — governa dashboard, e-mails e PDFs gerados pro tenant
// (item 1 do roadmap, 06/08/2026). Rota separada da preferência de tema
// (essa é por dispositivo/localStorage; idioma é da empresa toda, salvo no
// banco, porque e-mails/PDFs são gerados fora de uma sessão de navegador).
enum Locale {
  pt
  en
}

enum SubscriptionStatus {
  TRIAL
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal  @db.Decimal(10, 2)
  maxUsers     Int?
  features     String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenants       Tenant[]
  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String
  planId                 String
  asaasId                String?
  status                 SubscriptionStatus @default(TRIAL)
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  lastProcessedPaymentId String?
  // Quantos avisos de atraso já saíram NESTE ciclo vencido (0, 1 ou 2). Um
  // contador em vez de "data do último aviso" porque o cron roda uma vez por
  // dia e pode falhar num dia: com o contador ele se recupera enviando o aviso
  // mais urgente que ainda não foi, em vez de pular o marco perdido pra sempre
  // — exatamente o defeito que o cron de NPS já teve (seção 9). Zera quando o
  // pagamento entra.
  pastDueWarningsSent    Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  // requireActiveSubscription() consulta por tenantId em PRATICAMENTE TODA
  // requisição do sistema — é a consulta mais quente que existe aqui.
  @@index([tenantId])
  // Webhook da Asaas chega identificando a assinatura pelo id deles.
  @@index([asaasId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id
  name      String
  email     String   @unique
  role      UserRole @default(TECHNICIAN)
  tenantId  String
  document  String?
  phone     String?
  /// A filial da pessoa. NULL = nao esta presa a nenhuma, e ve tudo.
  branchId  String?

  /// Avisos que esta pessoa SILENCIOU. Catalogo em lib/notificacoes.ts.
  /// Lista vazia = recebe tudo, que e o comportamento de hoje. Guarda os
  /// silenciados e nao os desejados pelo mesmo motivo do disabledFeatures:
  /// lista vazia nao pode significar "nao recebe nada".
  mutedNotifications String[] @default([])

  /// Notificacao sem som nem vibracao para esta pessoa.
  ///
  /// E o UNICO controle de som que a web permite. Escolher o TOQUE nao e
  /// possivel: a propriedade `sound` foi removida da especificacao e nenhum
  /// navegador implementa — no Android o som vem do canal de notificacao, que
  /// e do sistema operacional. Quem troca o toque e a pessoa, no aparelho.
  silentNotifications Boolean @default(false)

  /// A assinatura desta pessoa, desenhada uma vez e reutilizada nos documentos
  /// que ela emite: a OS que ela conclui, o orcamento que ela envia, o contrato,
  /// a ordem de compra. PNG embutido (data URI), igual ao logo da empresa — o
  /// PDF nao busca nada na rede e o reprocessamento no servidor neutraliza
  /// qualquer payload escondido no desenho. Regra em lib/assinatura.ts.
  /// NULL = ainda nao desenhou; o documento sai com a linha para assinar a mao,
  /// como sempre saiu.
  signatureUrl String? @db.Text
  createdAt DateTime @default(now())

  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  serviceOrders     ServiceOrder[]
  location          UserLocation?
  pushSubscriptions PushSubscription[]
  userAddress       UserAddress?
  serviceContracts  ServiceContract[]
  stockMovements    StockMovement[]
  orderEvents       OrderEvent[]
  quotesCriados     Quote[]

  // Aba Equipe lista por tenant; seleção de técnico filtra por papel.
  @@index([tenantId, role])
  @@index([branchId])
  stockLocations     StockLocation[]
  assets             Asset[]
  supportThreads     SupportThread[]
}

model UserAddress {
  id         String  @id @default(cuid())
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?
  userId     String  @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  OWNER
  ADMIN
  GERENTE
  ATENDIMENTO
  COMERCIAL
  FINANCEIRO
  LOGISTICA
  TECHNICIAN
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Client {
  id           String       @id @default(cuid())
  name         String
  document     String?
  email        String?
  phone        String?
  whatsapp     String?
  status       ClientStatus @default(ACTIVE)
  // Valores dos CustomField de entity=CLIENT: { [customFieldId]: valor }
  customValues Json?        @db.JsonB
  tenantId     String
  /// NULL = cliente da empresa toda, visivel em todas as filiais.
  branchId     String?
  /// O CONTRATANTE deste cliente, quando ele e subcliente de alguem.
  ///
  /// Caso: administradora fecha contrato, servico e feito em cada condominio.
  /// NULL = cliente normal, que e o caso de todos os que ja existem.
  ///
  /// UM NIVEL SO: subcliente nao pode ter subcliente. Isso mata o risco de
  /// ciclo pela raiz, em vez de exigir deteccao de laco em toda gravacao.
  /// Regra em lib/subcliente.ts.
  parentId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// SetNull, e nao Cascade: apagar a administradora nao pode levar junto
  /// trinta condominios com historico, receita e nota emitida.
  parent        Client?           @relation("Subclientes", fields: [parentId], references: [id], onDelete: SetNull)
  subclientes   Client[]          @relation("Subclientes")
  ordensComoPagador ServiceOrder[] @relation("OsPagador")
  address       Address?
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  serviceOrders ServiceOrder[]
  equipments    Equipment[]
  contracts     ServiceContract[]

  // getClients(): where tenantId [+ status] order by createdAt desc
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, parentId])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DEFAULTER
}

model Address {
  id         String  @id @default(cuid())
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?
  latitude   Float?
  longitude  Float?
  clientId   String  @unique

  /// Quantas vezes ja se tentou geocodificar sem sucesso.
  ///
  /// Existe pra impedir inanicao da fila: endereco que nunca resolve (cidade
  /// digitada errada, rua inexistente) ficaria na frente pra sempre, ocupando
  /// as vagas do lote e impedindo endereco NOVO de ser processado. O mapa
  /// pararia de encher e nada avisaria ninguem. A fila ordena por este
  /// contador, entao quem nunca foi tentado passa na frente de quem ja falhou.
  geocodeTries Int @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Fila de geocodificacao: where latitude is null + geocodeTries < teto,
  // order by geocodeTries, id
  @@index([geocodeTries])
}

// ─── Ordem de Serviço ─────────────────────────────────────────────────────────

model ServiceOrder {
  id                 String        @id @default(cuid())
  number             Int
  title              String
  description        String?
  conclusionNote     String?
  status             ServiceStatus @default(OPEN)
  totalAmount        Decimal       @default(0) @db.Decimal(12, 2)
  clientId           String
  /// Quem PAGA por esta OS. NULL = o padrao (contratante quando existe, senao
  /// o proprio cliente). Existe porque a administradora paga quase tudo, mas
  /// as vezes o cliente final paga direto um servico extra. Regra em
  /// lib/subcliente.ts.
  payerId            String?
  tenantId           String
  /// Herdada do CLIENTE, e nao de quem digitou: o cliente e da unidade que o
  /// atende, e um atendente da matriz abrindo OS pra cliente da filial nao
  /// muda de quem e aquele cliente. Ver lib/filial.ts.
  branchId           String?
  technicianId       String?
  scheduledAt        DateTime?
  concludedAt        DateTime?
  nfseId             String?
  /// Quantas vezes ja se perguntou ao emissor pelo estado desta nota.
  ///
  /// Existe para o sistema DESISTIR. Emissao e assincrona e a nota pode ficar
  /// pendente para sempre por problema na prefeitura — sem teto, o cron
  /// perguntaria todo dia, para sempre, por uma nota que precisa de alguem
  /// olhando e nao de mais uma consulta. Regra em lib/nfse-status.ts.
  nfseChecks         Int           @default(0)

  /// Quando a nota saiu. Existe para a COTA MENSAL de NFS-e poder ser contada:
  /// uma OS aberta em julho e faturada em agosto gasta a cota de AGOSTO, e
  /// contar pelo createdAt da OS deixaria a cota do mes passado ser gasta neste.
  nfseIssuedAt       DateTime?
  nfseNumber         String?
  nfseStatus         String?
  nfseUrl            String?
  clientSignatureUrl String?
  clientToken        String?       @unique @default(uuid())
  // Valores dos CustomField de entity=SERVICE_ORDER: { [customFieldId]: valor }
  customValues       Json?         @db.JsonB
  /// Preenchido quando a OS nasceu de um contrato recorrente.
  /// Garantia desta OS em dias. Vazio = usa o padrao da empresa.
  warrantyDays       Int?
  contractId         String?
  npsScore           Int?
  npsFeedback        String?
  npsSentAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client         Client           @relation(fields: [clientId], references: [id])
  payer          Client?          @relation("OsPagador", fields: [payerId], references: [id], onDelete: SetNull)
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  technician     User?            @relation(fields: [technicianId], references: [id])
  items          ServiceItem[]
  attachments    Attachment[]
  revenues       Revenue[]
  checklist      ChecklistItem[]
  contract       ServiceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  orderEvents    OrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId])
  // Cota mensal de NFS-e: notas emitidas por esta empresa desde o inicio do mes.
  @@index([tenantId, nfseIssuedAt])
  // Listagem de OS e "OS ativas" do dashboard.
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  // Dashboard soma OS concluídas no mês; cron de NPS varre por concludedAt.
  @@index([tenantId, concludedAt])
  // Agenda: where tenantId + scheduledAt entre X e Y.
  @@index([tenantId, scheduledAt])
  // FKs: histórico do cliente, OS por técnico, e o cascade ao apagar cliente.
  @@index([clientId])
  @@index([technicianId])
  quotes         Quote[]

}

model ChecklistItem {
  id          String   @id @default(cuid())
  orderId     String
  description String
  completed   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  DONE
  INVOICED
  CANCELLED
}

model ServiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  orderId     String
  /// Peca do catalogo, quando o item veio do estoque. Nulo = item digitado
  /// na hora (mao de obra, taxa, peca comprada avulsa) — que continua sendo
  /// o caminho normal pra quem nao controla estoque.
  partId      String?

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part?        @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([partId])
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  /// O dono da foto: uma OS OU um orcamento, nunca os dois e nunca nenhum.
  ///
  /// A obrigatoriedade virou um CHECK no banco (Attachment_um_dono_so), porque
  /// o Prisma nao sabe expressar "exatamente um destes". Sem ele, "opcional dos
  /// dois lados" viraria foto orfa: linha que nao aparece em tela alguma, ocupa
  /// armazenamento e ninguem consegue apagar pela interface.
  orderId   String?
  quoteId   String?
  /// A NOTA do fornecedor, anexada a uma ordem de compra.
  ///
  /// Terceiro dono possivel deste anexo. A trava no banco passou de "um dos
  /// dois" para "exatamente um dos tres" — ver a migration.
  purchaseOrderId String?
  /// A nota fiscal (ou a foto) de um BEM da empresa. Quarto dono possivel.
  /// A trava `num_nonnulls(...) = 1` cresce com um argumento a mais — foi
  /// exatamente para isto que ela deixou de ser escrita a mao.
  assetId         String?
  createdAt DateTime @default(now())

  order ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quote Quote?        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  asset         Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([assetId])

}

// ─── Financeiro ───────────────────────────────────────────────────────────────

model Revenue {
  id          String        @id @default(cuid())
  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus @default(PENDING)
  tenantId    String
  orderId     String?
  /// Herdada da OS que gerou a receita.
  branchId    String?
  createdAt   DateTime      @default(now())

  /// Quantos degraus da regua de cobranca ja passaram para esta conta.
  /// Contador, e nao "data do ultimo aviso": o cron roda uma vez por dia e
  /// pode falhar num dia — contando degraus, o dia perdido se recupera
  /// sozinho. Regra e escada em lib/regua-cobranca.ts.
  remindersSent Int @default(0)

  branch Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  ServiceOrder? @relation(fields: [orderId], references: [id])

  // Card do dashboard + gráfico de 6 meses = 7 agregações por carregamento,
  // todas com a forma (tenantId, status PAID, paidAt entre X e Y).
  @@index([tenantId, status, paidAt])
  // Contador de vencidas e listagem do Financeiro, por dueDate.
  @@index([tenantId, status, dueDate])
  // Anti-join do dashboard (`revenues: { none: {} }`) e receita da OS.
  @@index([orderId])
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus   @default(PENDING)
  category    ExpenseCategory @default(OTHER)
  tenantId    String
  recurring   Boolean         @default(false)
  /// Escolhida no cadastro da despesa.
  branchId    String?
  /// A COMPRA que gerou esta despesa.
  ///
  /// Existe porque ate 01/09/2026 a compra entrava no estoque e nao saia do
  /// caixa: a empresa comprava R$ 2.400, o saldo subia, e o Financeiro nao
  /// ficava sabendo. Com o vinculo da para ir da despesa ate a nota que a
  /// originou — e de volta.
  ///
  /// SetNull: apagar a ordem de compra nao pode apagar o dinheiro que saiu.
  purchaseOrderId String?
  createdAt   DateTime        @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tenant Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  // Mesma forma da Revenue: gráfico do dashboard e listagem do Financeiro.
  @@index([tenantId, status, paidAt])
  @@index([tenantId, status, dueDate])
  @@index([purchaseOrderId])

}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  FIXED
  VARIABLE
  OTHER
}

// ─── Prestadores de Serviço ───────────────────────────────────────────────────

model Provider {
  id        String   @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  specialty String?
  notes     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  maintenanceOrders MaintenanceOrder[]

  // getProviders(): where tenantId order by name asc
  @@index([tenantId, name])
}

// ─── Ordem de Manutenção Interna ──────────────────────────────────────────────

model MaintenanceOrder {
  id          String            @id @default(cuid())
  number      Int
  title       String
  description String?
  status      MaintenanceStatus @default(OPEN)
  totalAmount Decimal           @default(0) @db.Decimal(12, 2)
  tenantId    String
  providerId  String?
  /// O BEM que esta em manutencao. Da historico a van: quantas vezes parou,
  /// quanto ja custou, e quando. SetNull porque a manutencao aconteceu mesmo
  /// que o bem seja baixado depois.
  assetId     String?
  scheduledAt DateTime?
  concludedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  provider Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  asset    Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  items    MaintenanceItem[]

  @@unique([tenantId, number])
  // getMaintenanceOrders(): where tenantId [+ status] order by createdAt desc
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([providerId])
  @@index([assetId])

}

model MaintenanceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  orderId     String

  order MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─── Orçamentos ───────────────────────────────────────────────────────────────

model Quote {
  id            String      @id @default(cuid())
  number        Int
  clientName    String
  clientAddress String?
  clientContact String?
  description   String
  materials     String?
  amount        Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?
  status        QuoteStatus @default(DRAFT)
  /// A VISITA que originou este orcamento.
  ///
  /// O caso: o cliente chama, o tecnico vai ate o endereco, e no local o
  /// cliente so quer saber quanto custa. Sem o vinculo, aquela OS virava um
  /// deslocamento orfao — fechar com valor cheio cobraria servico que nao
  /// houve, cancelar apagaria a ida que aconteceu.
  ///
  /// SetNull, e nao Cascade: apagar a OS nao pode levar junto o orcamento que
  /// o cliente ja recebeu e talvez ja tenha aprovado.
  orderId       String?
  validUntil    DateTime?
  tenantId      String
  clientToken   String?     @unique @default(uuid())
  /// Quem emitiu o orcamento.
  ///
  /// Existe para a assinatura CERTA sair no PDF. Sem isto, so daria para
  /// carimbar quem esta BAIXANDO o documento — e um administrador baixando o
  /// orcamento da Ana sairia com a assinatura dele. Assinatura errada e pior
  /// que assinatura nenhuma: e atestado falso.
  ///
  /// NULL nos orcamentos criados antes desta coluna: eles saem com a linha
  /// para assinar a mao, como sempre sairam.
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Fotos do que sera feito. E no orcamento que a foto mais trabalha: e o
  /// documento que o cliente le para DECIDIR.
  fotos     Attachment[]

  @@unique([tenantId, number])
  // getQuotes(): where tenantId [+ status] order by createdAt desc
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([createdById])
  order         ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Buscar o orcamento de uma visita.
  @@index([orderId])

}

// ─── Equipamentos do Cliente ──────────────────────────────────────────────────

model Equipment {
  id            String    @id @default(cuid())
  tenantId      String
  clientId      String
  name          String
  brand         String?
  model         String?
  serialNumber  String?
  installDate   DateTime?
  warrantyUntil DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  // Equipamentos na ficha do cliente + cascade ao apagar o cliente.
  @@index([clientId])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

// ─── Controle de Acesso ───────────────────────────────────────────────────────

/// Unidade da empresa. Uma empresa com matriz e filiais.
///
/// O QUE E ESCOPADO por filial: clientes, ordens de servico, agenda,
/// financeiro (receitas e despesas) e a equipe.
/// O QUE E COMPARTILHADO, por decisao: estoque e pecas, fornecedores e
/// compras, orcamentos, contratos, configuracoes, plano e cobranca.
///
/// A lista de compartilhados nao e esquecimento: 447 consultas do sistema
/// filtram por tenantId, e escopar todas de uma vez seria reescrever o
/// sistema. Filial meio-feita — algumas telas filtrando e outras nao — e PIOR
/// que nenhuma, porque promete separacao e vaza. Regra em lib/filial.ts.
///
/// TODO branchId nasce NULL, e registro sem filial e visto por TODOS. Sem
/// isso, criar a primeira filial faria a base historica inteira sumir da tela.
model Branch {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  clients       Client[]
  serviceOrders ServiceOrder[]
  revenues      Revenue[]
  expenses      Expense[]

  @@index([tenantId, active])
}

model TabPermission {
  id       String   @id @default(cuid())
  tenantId String
  role     UserRole
  tab      String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, tab])
}

/// O certificado digital A1 da empresa, para emitir nota fiscal.
///
/// TABELA PROPRIA, e nao colunas no Tenant, de proposito: assim o certificado
/// NUNCA vem junto num `include: { tenant: true }` distraido. Quem precisa
/// dele tem que pedir por nome — e pedir por nome e uma decisao, nao um
/// acidente. Mesmo raciocinio do contrato publico da API.
///
/// O arquivo e a senha ficam CIFRADOS (AES-256-GCM, lib/cofre.ts), com a chave
/// numa variavel de ambiente e nunca no banco. Um dump do banco — backup
/// vazado, acesso indevido ao Postgres — nao entrega certificado de ninguem.
///
/// Isto nao e paranoia: um A1 e a IDENTIDADE da empresa. Com ele e a senha,
/// alguem emite nota no CNPJ dela e assina documento como ela. Se um token de
/// WhatsApp vaza, troca-se o token; se um certificado vaza, so existe revogar
/// na certificadora e comprar outro.
model FiscalCertificate {
  id        String   @id @default(cuid())
  tenantId  String   @unique

  /// O .pfx cifrado. Formato: iv.tag.dados, tudo em base64.
  arquivo   String   @db.Text
  /// A senha cifrada, no mesmo formato.
  senha     String   @db.Text

  /// Nome do arquivo enviado, so para a tela mostrar o que esta la.
  nomeArquivo String?
  /// Validade informada por quem enviou. Serve ao aviso de vencimento —
  /// certificado vencido para de emitir NOTA, e ninguem descobre ate tentar.
  validoAte   DateTime?

  enviadoEm DateTime @default(now())
  enviadoPor String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Chave da API de integracao. Recurso do plano Enterprise.
///
/// O banco guarda o HASH, nunca a chave: ela e uma senha que vai parar em
/// arquivo de configuracao de terceiro, e um vazamento do banco (ou um backup
/// nosso, que circula por definicao) nao pode virar uma pilha de credenciais
/// validas. O `prefix` e publico e existe para achar a linha por indice — sem
/// ele, conferir uma chave exigiria testar o hash de todas as chaves de todas
/// as empresas. Formato e conferencia em lib/api-chave.ts.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  prefix     String    @unique
  hash       String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Permissao um degrau abaixo da aba: o que o papel pode FAZER dentro dela.
/// Catalogo em lib/acoes.ts. Existe porque a permissao por aba e grossa demais
/// para o caso que mais importa — hoje qualquer tecnico com a aba de OS reescreve
/// os itens e o VALOR TOTAL de um servico ja executado.
model ActionPermission {
  id       String   @id @default(cuid())
  tenantId String
  role     UserRole
  action   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, action])
}

// ─── Notificações Push ────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

// ─── Equipe de administração da plataforma ───────────────────────────────────
//
// Até 10/08/2026 o painel aceitava UM e-mail, fixo em código: não havia como
// adicionar ninguém sem substituir o dono. Aqui a equipe vira dado, com papel
// por área — e a matriz de quem pode o quê mora em lib/admin.ts.
//
// Isto NÃO se confunde com a equipe DA empresa cliente (model User, com
// OWNER/ADMIN/TECHNICIAN). Estes são funcionários da plataforma, e nenhum
// deles pertence a um Tenant.
model PlatformAdmin {
  id         String       @id @default(cuid())
  email      String       @unique
  name       String
  role       PlatformRole
  phone      String?
  document   String?
  /**
   * Desativar corta o acesso mas mantém o cadastro (dá pra reativar). Remover
   * apaga a linha — o AdminAuditLog guarda o e-mail como texto, então o
   * histórico do que a pessoa fez continua legível mesmo depois.
   */
  active     Boolean      @default(true)
  invitedBy  String?
  /**
   * Primeiro acesso ao painel: prova de que a pessoa recebeu o convite e
   * entrou de fato, em vez de o registro ficar pendurado sem ninguém.
   */
  acceptedAt DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([email, active])
}

enum PlatformRole {
  DONO
  FINANCEIRO
  COMERCIAL
  LOGISTICO
  TI
}

// ─── Retrato mensal do negócio ───────────────────────────────────────────────
//
// Os gráficos do /admin nasceram reconstruindo o passado a partir das datas de
// criação e cancelamento das assinaturas. Funciona, mas mente em silêncio: se
// uma empresa ficou 2 meses inadimplente e voltou, a reconstrução mostra ela
// como pagante o tempo todo, porque só existem as datas das pontas.
//
// Aqui o número de cada mês é gravado como ele era NAQUELE mês. O cron diário
// atualiza o retrato do mês corrente (upsert por `month`), então meses passados
// congelam com o último valor real que tiveram e o mês atual está sempre fresco.
model MonthlySnapshot {
  id                 String   @id @default(cuid())
  /**
   * 'AAAA-MM' no horário de Brasília.
   */
  month              String   @unique
  companies          Int
  activeCompanies    Int
  pendingCompanies   Int
  pastDueCompanies   Int
  cancelledCompanies Int
  users              Int
  payingUsers        Int
  mrr                Decimal  @db.Decimal(12, 2)
  capturedAt         DateTime @updatedAt

  @@index([month])
}

// ─── Auditoria do painel do dono da plataforma ───────────────────────────────
//
// Toda ação do /admin sobre uma empresa cliente é gravada aqui: liberar acesso,
// cancelar, trocar plano e — principalmente — entrar na conta do cliente. Isso
// existe por dois motivos: se algo der errado numa conta de cliente, dá pra
// saber se foi ele ou foi o suporte; e porque acesso a dado de terceiro sem
// registro é problema de LGPD, não só de organização.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  tenantId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
}

// ─── Rate limiting (login/cadastro/recuperação de senha) ─────────────────────

model AuthRateLimit {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
}

// ─── Localização GPS ──────────────────────────────────────────────────────────

model UserLocation {
  id        String   @id @default(cuid())
  userId    String   @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Campos personalizados ────────────────────────────────────────────────────
//
// O ServiçoOS atende qualquer prestador de serviço, e cada ramo guarda coisas
// diferentes: um pet shop precisa de "raça/porte", uma empresa de limpeza de
// "metragem", uma de TI de "número de série". Sem isto, todo mundo é forçado no
// mesmo formulário e cada segmento novo esbarra numa parede.
//
// As DEFINIÇÕES ficam aqui, por tenant. Os VALORES ficam num Json no próprio
// registro (Client.customValues / ServiceOrder.customValues) em vez de numa
// tabela de valores com chave estrangeira polimórfica. Motivos:
//
//  - Apagar um campo não deixa valor órfão: a leitura só renderiza os campos
//    que ainda existem, e a chave que sobra no Json é ignorada.
//  - A exportação de dados (LGPD) leva os valores junto sem precisar lembrar
//    de incluir mais uma relação — o que é exatamente o tipo de coisa que se
//    esquece e vira dado faltando no pedido de titular.
//
// A contrapartida assumida: não dá pra filtrar/ordenar por campo personalizado
// com índice, como daria numa coluna. Quando isso for pedido, o caminho é um
// índice GIN no Json, não remodelar.

enum CustomFieldEntity {
  CLIENT
  SERVICE_ORDER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model CustomField {
  id        String            @id @default(cuid())
  tenantId  String
  entity    CustomFieldEntity
  label     String
  type      CustomFieldType   @default(TEXT)
  // Só usado quando type = SELECT.
  options   String[]          @default([])
  required  Boolean           @default(false)
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // getCustomFields(): where tenantId + entity order by position
  @@index([tenantId, entity, position])
}

// ─── Contrato de serviço recorrente ───────────────────────────────────────────
//
// Boa parte do mercado de serviço vive de contrato, não de chamado avulso:
// limpeza semanal, jardinagem mensal, suporte de TI, piscina quinzenal,
// dedetização trimestral. O sistema só sabia lidar com o avulso.
//
// NÃO confundir com MaintenanceOrder: aquela é manutenção da frota e dos
// equipamentos DA PRÓPRIA EMPRESA. Esta é serviço prestado AO CLIENTE, que se
// repete — e que gera OS de verdade, sozinho, na data certa.
//
// A geração acontece no cron diário, com antecedência (ver
// lib/contrato-recorrente.ts): OS que nasce no dia da visita chega tarde
// demais pra encaixar na rota.

enum ContractFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model ServiceContract {
  id           String            @id @default(cuid())
  tenantId     String
  clientId     String
  title        String
  description  String?
  frequency    ContractFrequency
  /// Dia do mês escolhido no contrato. Guardado separado da última execução
  /// de propósito: um contrato no dia 31 executa em 28/fev e precisa VOLTAR
  /// pro 31 em março. Derivar da execução anterior faria a data andar pra
  /// trás a cada mês curto.
  dayOfMonth   Int?
  amount       Decimal           @default(0) @db.Decimal(12, 2)
  technicianId String?
  startsAt     DateTime
  endsAt       DateTime?
  /// Próxima data de execução. É o que o cron consulta.
  nextRunAt    DateTime
  lastRunAt    DateTime?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  technician User?          @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  orders     ServiceOrder[]

  // O cron busca: where active + nextRunAt <= limite
  @@index([active, nextRunAt])
  // getContracts(): where tenantId order by createdAt desc
  @@index([tenantId, createdAt])
  @@index([clientId])
}

/// Lote de geocodificacao ja enviado ao provedor, esperando resultado.
///
/// Existe porque o lote e assincrono e funcao serverless tem orcamento de
/// tempo curto: sem guardar o job, um lote que demore mais que o orcamento
/// seria abandonado e reenviado todo dia, para sempre — o mapa nunca
/// encheria e nada avisaria ninguem.
///
/// Nao tem tenantId de proposito: o backfill e da plataforma inteira, e um
/// lote pode carregar enderecos de empresas diferentes. O isolamento entre
/// empresas continua valendo onde importa — cada Address so e atualizado pelo
/// id que ja estava na fila.
model GeocodeBatch {
  id         String   @id @default(cuid())
  jobId      String   @unique
  /// Ids de Address na MESMA ordem em que foram enviados. O casamento do
  /// resultado e por indice, entao esta ordem e o que impede o cliente de
  /// receber a coordenada do vizinho.
  addressIds Json
  createdAt  DateTime @default(now())
}

// ─── Estoque de pecas e ordens de compra ─────────────────────────────────────

/// Fornecedor de pecas. Separado de Provider de proposito: aquele e prestador
/// TERCEIRIZADO, que executa servico pra empresa; este e quem VENDE peca pra
/// ela. Juntar os dois daria uma lista so com duas coisas diferentes dentro,
/// e o dia em que precisassem de campos distintos ninguem conseguiria separar.
/// Quem VENDE peca e material para a empresa.
///
/// Nao confundir com Provider (prestador), que PRESTA servico para ela. Sao
/// dois cadastros diferentes de proposito: o fornecedor entra em compra e
/// cotacao, o prestador entra em manutencao.
///
/// Todos os campos alem do nome sao OPCIONAIS. Ja existem fornecedores gravados
/// so com nome, e campo obrigatorio travaria a EDICAO deles — a pessoa abriria
/// a ficha para corrigir o telefone e teria de preencher CEP e razao social
/// antes de salvar. Cadastro pobre e melhor que cadastro impossivel de corrigir.
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  /// Como a empresa CHAMA o fornecedor. Nome fantasia.
  name      String
  /// A razao social, que e o que sai na nota.
  legalName String?
  /// CNPJ ou CPF como a pessoa digitou, com mascara — e o que ela reconhece.
  document  String?
  /// So os digitos do mesmo documento. Serve para descobrir que
  /// "12.345.678/0001-99" e "12345678000199" sao o MESMO fornecedor cadastrado
  /// duas vezes. Derivado de `document`, sempre pela mesma funcao.
  documentDigits    String?
  stateRegistration String?
  cityRegistration  String?
  /// Ramo, em texto livre. Enum obrigaria migration a cada ramo novo.
  category  String?

  email     String?
  phone     String?
  /// Quem atende. O telefone da empresa e uma coisa; o celular do vendedor que
  /// resolve e outra, e e esse que o dono liga.
  contactName  String?
  contactPhone String?
  website      String?

  /// Endereco em colunas proprias, e nao na tabela Address: aquela e presa ao
  /// Client e carrega a fila de geocodificacao. Os nomes sao identicos aos de
  /// Address de proposito — no dia em que generalizar valer a pena, e mover
  /// coluna, e nao renomear nada.
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?

  /// O lado comercial: e o que decide de quem comprar quando o preco empata.
  paymentTerms String?
  leadTimeDays Int?
  pixKey       String?
  bankName     String?
  bankAgency   String?
  bankAccount  String?

  /// Desativar substitui apagar. Fornecedor que ja participou de cotacao nao
  /// pode ser apagado — o banco recusa (ver QuotationParticipant).
  active        Boolean   @default(true)
  deactivatedAt DateTime?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId, name])
  // Listagem filtra por ativo; a busca de duplicata casa pelos digitos.
  @@index([tenantId, active])
  @@index([tenantId, documentDigits])
  quotations QuotationParticipant[]

}

/// Peca de estoque.
///
/// `stock` NUNCA e editado direto: toda mudanca passa por um StockMovement,
/// dentro de transacao. Sem essa regra o historico e o saldo passam a
/// discordar, e nao ha como saber qual dos dois esta certo — que e o momento
/// em que a empresa para de confiar no estoque e volta pro caderno.
model Part {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// Codigo interno da empresa. Opcional: muita empresa pequena nao usa.
  sku       String?
  unit      String   @default("un")
  /// Quanto custa comprar. Atualizado ao receber uma ordem de compra.
  costPrice Decimal? @db.Decimal(12, 2)
  /// Quanto se cobra do cliente. Vira o preco sugerido no item da OS.
  salePrice Decimal? @db.Decimal(12, 2)
  stock     Decimal  @default(0) @db.Decimal(12, 3)
  /// Abaixo disto a peca aparece como alerta. Zero = sem alerta.
  minStock  Decimal  @default(0) @db.Decimal(12, 3)
  /// Peca desativada some das listas de escolha, mas o historico continua.
  /// Apagar quebraria movimento e item de OS ja registrados.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  movements     StockMovement[]
  balances      StockBalance[]
  purchaseItems PurchaseItem[]
  quotationItems QuotationItem[]
  serviceItems  ServiceItem[]

  // Listagem e busca por nome; a de escolha filtra por active.
  @@index([tenantId, name])
  @@index([tenantId, active])
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

/// Um movimento de estoque. Fonte da verdade do saldo.
///
/// `quantity` guarda a VARIACAO COM SINAL (+5 numa entrada, -2 numa saida,
/// -3 num ajuste de 10 pra 7). Assim a soma dos movimentos de uma peca tem
/// que ser igual ao saldo dela — invariante que da pra testar, e que um
/// campo "quantidade sempre positiva + tipo" nao daria sem recalcular sinal
/// em toda leitura.
/// Onde a peca FICA. Num negocio de campo a van de cada tecnico e um
/// almoxarifado que anda — "tem 4 no estoque" nao responde "onde", e a peca
/// pode estar do outro lado da cidade. Regras em lib/estoque-local.ts.
/// Um BEM da empresa: a van, a rotativa, o notebook, a bancada.
///
/// NAO e peca de estoque (`Part`, comprada para aplicar no servico) nem
/// equipamento do cliente (`Equipment`, que nem e da empresa). Sao tres coisas
/// com cara parecida e naturezas opostas — ativo, mercadoria e coisa alheia.
///
/// Depreciacao e regras em lib/patrimonio.ts. Os numeros sao GERENCIAIS: o
/// balanco com valor legal e peca que o contador assina.
model Asset {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  category       AssetCategory @default(OUTRO)
  brand          String?
  model          String?
  /// Numero de serie, placa do veiculo, patrimonio colado na etiqueta.
  serialNumber   String?
  /// Quanto custou, e quando. Sao a base da depreciacao inteira.
  purchaseValue  Decimal       @db.Decimal(12, 2)
  purchasedAt    DateTime
  /// Taxa anual PROPRIA, quando difere da padrao da categoria.
  /// NULL usa a da tabela da Receita (lib/patrimonio.ts).
  annualRate     Decimal?      @db.Decimal(5, 2)
  /// Quanto se espera receber ao vender no fim da vida util. Nao deprecia.
  residualValue  Decimal?      @db.Decimal(12, 2)
  status         AssetStatus   @default(ATIVO)
  /// Quando saiu do patrimonio (venda, perda, descarte). Depois dela o bem
  /// PARA de depreciar — continuar inventaria despesa que nao existe.
  disposedAt     DateTime?
  disposalNotes  String?
  /// ONDE ele esta. Reaproveita os locais de estoque: a rotativa que esta na
  /// van do Carlos responde a mesma pergunta que "onde esta a peca".
  /// SetNull: apagar o local nao pode apagar o bem que estava nele.
  locationId     String?
  /// QUEM responde por ele. Util para o que nao mora em local nenhum — o
  /// notebook esta com a Ana, e nao no almoxarifado.
  responsibleId  String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  responsible User?          @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  maintenance MaintenanceOrder[]

  // Listagem da aba: por empresa, os ativos primeiro, do mais novo pro velho.
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([locationId])
  @@index([responsibleId])
}

enum BalanceGroup {
  ATIVO_CIRCULANTE
  ATIVO_NAO_CIRCULANTE
  PASSIVO_CIRCULANTE
  PASSIVO_NAO_CIRCULANTE
  PATRIMONIO_LIQUIDO
}

/// Uma linha do balanco que vive FORA do sistema: emprestimo, financiamento da
/// van, imovel nao cadastrado, reserva de lucros.
///
/// Generica de proposito. A alternativa era um campo por tipo — `emprestimos`,
/// `bancos`, `outrosAtivos` — e o quarto tipo, quando aparecesse, seria
/// esquecido. Grupo + descricao + valor cresce sozinho.
model BalanceEntry {
  id          String       @id @default(cuid())
  tenantId    String
  group       BalanceGroup
  description String
  /// Aceita NEGATIVO: conta retificadora existe. "(-) Provisao para devedores
  /// duvidosos" e linha legitima do ativo, e travar em zero obrigaria a empresa
  /// a mentir no balanco para caber na regra do sistema.
  amount      Decimal      @db.Decimal(14, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // A tela le todas as linhas da empresa de uma vez, agrupadas.
  @@index([tenantId, group])
}

enum AssetCategory {
  VEICULO
  MAQUINA
  FERRAMENTA
  INFORMATICA
  MOVEL
  IMOVEL
  TERRENO
  OUTRO
}

enum AssetStatus {
  ATIVO
  MANUTENCAO
  BAIXADO
}

model StockLocation {
  id        String            @id @default(cuid())
  tenantId  String
  name      String
  type      StockLocationType @default(ALMOXARIFADO)
  /// O tecnico dono da van. Nulo no almoxarifado.
  /// SetNull ao apagar a pessoa: a van continua existindo com o que tem dentro.
  userId    String?
  /// Desativado some das escolhas, mas o historico continua. So e permitido
  /// desativar local VAZIO — ver podeDesativarLocal.
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  balances  StockBalance[]
  assets    Asset[]
  saidas    StockMovement[] @relation("MovimentoNoLocal")
  entradas  StockMovement[] @relation("MovimentoParaLocal")

  /// Dois locais com o mesmo nome na mesma empresa seriam indistinguiveis na
  /// hora de escolher — e a escolha errada move peca de verdade.
  @@unique([tenantId, name])
  @@index([tenantId, active])
}

/// Os setores do estoque. A ordem de exibicao e outra (ver TIPOS_DE_LOCAL em
/// lib/estoque-local.ts); aqui a ordem e a de criacao, porque o Postgres nao
/// reordena nem remove valor de enum — acrescentar e decisao sem volta.
enum StockLocationType {
  ALMOXARIFADO
  VEICULO
  /// Onde a compra CHEGA e ainda nao foi conferida.
  RECEBIMENTO
  /// Chao de fabrica: material ja separado para ser consumido.
  PRODUCAO
  /// O que esta separado para SAIR — carga de van, entrega, retirada.
  EXPEDICAO
}

/// O saldo de uma peca EM UM local.
///
/// Part.stock continua sendo o TOTAL, porque ele ja e lido pelo alerta de
/// minimo, pela listagem, pela escolha na OS e pelos relatorios — troca-lo por
/// uma soma seria refazer meia duzia de telas pro mesmo numero. Os dois sao
/// escritos na MESMA transacao, e ha teste garantindo que o total e a soma.
model StockBalance {
  id         String  @id @default(cuid())
  partId     String
  locationId String
  quantity   Decimal @default(0) @db.Decimal(12, 3)

  part     Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Um saldo por peca por local. Duplicado faria a soma contar duas vezes.
  @@unique([partId, locationId])
  @@index([locationId])
}

model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  partId          String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  /// Saldo logo apos este movimento. Fotografia: deixa o historico legivel
  /// sem precisar somar tudo de novo a cada linha da tela.
  balanceAfter    Decimal           @db.Decimal(12, 3)
  reason          String?
  /// De qual OS saiu.
  orderId         String?
  /// De qual ordem de compra entrou.
  purchaseOrderId String?
  /// EM QUAL LOCAL este movimento aconteceu. `balanceAfter` passa a ser o
  /// saldo DAQUELE local, e nao mais o total da empresa.
  locationId      String?
  /// Para onde foi, quando este movimento e a perna de saida de uma
  /// TRANSFERENCIA. Serve so para a tela contar a historia ("saiu para a Van
  /// do Carlos"); quem move o saldo sao as duas pernas.
  toLocationId    String?
  /// Liga as duas pernas da mesma transferencia. Transferencia e um PAR de
  /// movimentos (saida na origem, entrada no destino) e nao um tipo novo,
  /// porque `balanceAfter` e por local — uma linha so nao guarda dois saldos.
  transferId      String?
  /// Quem fez. Fica nulo se a pessoa sair da empresa — o movimento continua.
  userId          String?
  createdAt       DateTime          @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  part          Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  order         ServiceOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  location      StockLocation? @relation("MovimentoNoLocal", fields: [locationId], references: [id], onDelete: SetNull)
  toLocation    StockLocation? @relation("MovimentoParaLocal", fields: [toLocationId], references: [id], onDelete: SetNull)

  // Historico da peca, do mais novo pro mais velho.
  @@index([partId, createdAt])
  @@index([tenantId, createdAt])
  // Idempotencia da baixa por OS: "ja existe movimento desta OS?"
  @@index([orderId])
  @@index([purchaseOrderId])
  // Historico de um local.
  @@index([locationId, createdAt])
}

enum PurchaseStatus {
  RASCUNHO
  ENVIADA
  PARCIAL
  RECEBIDA
  CANCELADA
}

/// Ordem de compra de pecas ao fornecedor.
/// Cotacao: pedir preco a varios fornecedores antes de comprar.
///
/// O que ela responde e uma pergunta que a ordem de compra nao responde: "de
/// quem eu compro?". Sem isso, a empresa liga para tres fornecedores, anota
/// num papel e o papel some — e na proxima compra a comparacao e refeita do
/// zero, muitas vezes com o mesmo resultado.
///
/// Regras de comparacao em lib/cotacao.ts.
model Quotation {
  id          String          @id @default(cuid())
  tenantId    String
  number      Int
  title       String
  status      QuotationStatus @default(ABERTA)
  /// Ate quando os fornecedores tem para responder. So informativo — nada
  /// fecha sozinho, porque fornecedor atrasado que responde bem ainda ganha.
  deadline    DateTime?
  notes       String?         @db.Text
  /// Quem venceu, quando a cotacao foi fechada. Guardado para o historico
  /// continuar legivel depois de a compra ter sido gerada.
  winnerId    String?
  closedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        QuotationItem[]
  participants QuotationParticipant[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

enum QuotationStatus {
  ABERTA
  FECHADA
  CANCELADA
}

/// O que se esta cotando, e quanto.
model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  partId      String
  quantity    Decimal @db.Decimal(12, 3)

  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  part      Part             @relation(fields: [partId], references: [id])
  prices    QuotationPrice[]

  /// A mesma peca duas vezes na mesma cotacao faria a comparacao contar o
  /// dobro e o total do fornecedor sair errado.
  @@unique([quotationId, partId])
  @@index([partId])
}

/// Um fornecedor CONVIDADO a cotar.
///
/// Existe como linha propria (e nao so como preco) para o sistema saber a
/// diferenca entre "nao respondeu" e "respondeu que nao tem" — que sao coisas
/// diferentes na hora de decidir a quem ligar da proxima vez.
model QuotationParticipant {
  id          String    @id @default(cuid())
  quotationId String
  supplierId  String
  notes       String?
  respondedAt DateTime?

  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  /// RESTRICT, e nao Cascade.
  ///
  /// Com Cascade, apagar um fornecedor apagava em silencio a participacao dele
  /// em TODA cotacao e os precos que ele deu — o historico que este modulo
  /// existe para guardar. E como a unica forma de corrigir um dado errado era
  /// apagar e recadastrar, o caminho para perder o historico era o caminho
  /// NORMAL de uso. Fornecedor que ja cotou nao se apaga, se DESATIVA.
  supplier  Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  prices    QuotationPrice[]

  /// Convidar o mesmo fornecedor duas vezes duplicaria a coluna dele na
  /// comparacao.
  @@unique([quotationId, supplierId])
  @@index([supplierId])
}

/// O preco que UM fornecedor deu para UM item.
model QuotationPrice {
  id            String  @id @default(cuid())
  participantId String
  itemId        String
  unitPrice     Decimal @db.Decimal(12, 2)

  participant QuotationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  item        QuotationItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Um preco por fornecedor por item. Dois faria a soma contar duas vezes.
  @@unique([participantId, itemId])
  @@index([itemId])
}

model PurchaseOrder {
  id         String         @id @default(cuid())
  number     Int
  tenantId   String
  supplierId String?
  status     PurchaseStatus @default(RASCUNHO)
  /// Quando se espera receber. So pra cobrar o fornecedor.
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?        @db.Text
  total      Decimal        @default(0) @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  movements StockMovement[]
  expenses  Expense[]
  attachments Attachment[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([supplierId])
}

model PurchaseItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  partId           String
  quantity         Decimal @db.Decimal(12, 3)
  /// Quanto ja chegou. Entrega parcial e a regra, nao a excecao: fornecedor
  /// mandar 8 de 10 e comum, e um sistema que so aceita "tudo ou nada" faz a
  /// empresa parar de registrar.
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@index([purchaseOrderId])
  @@index([partId])
}

// ─── Historico de alteracao da OS ────────────────────────────────────────────

enum OrderEventType {
  CRIADA
  STATUS
  RESPONSAVEL
  AGENDAMENTO
  VALOR
  CONCLUSAO
  GARANTIA
}

/// Quem mudou o que, e quando, numa ordem de servico.
///
/// Ate 18/08/2026 existia log de auditoria do painel da plataforma, mas
/// NENHUM dos dados do cliente. Quando aparecia discussao — "esse valor nao
/// era esse", "quem cancelou?", "o tecnico era outro" — nao havia como saber.
/// Numa empresa de servico isso e a diferenca entre resolver em um minuto e
/// perder o cliente.
model OrderEvent {
  id       String         @id @default(cuid())
  tenantId String
  orderId  String
  type     OrderEventType

  /// Nome de quem fez, guardado como TEXTO.
  ///
  /// Nao e desnormalizacao por descuido: o historico precisa continuar
  /// legivel depois que a pessoa sai da empresa. Guardar so o id faria a
  /// linha do tempo virar "responsavel mudou para cmr04..." justamente no
  /// caso em que alguem vai consultar o registro.
  actorName String?
  actorId   String?

  /// Valor antes e depois, como texto. Para STATUS o texto E o codigo, e a
  /// tela traduz; para os demais ja vem legivel. Ver lib/historico-os.ts.
  before String?
  after  String?

  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  order  ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor  User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // A consulta e sempre "a linha do tempo desta OS, da mais nova pra mais velha".
  @@index([orderId, createdAt])
  @@index([tenantId, createdAt])
}

// ─── Saude do sistema ────────────────────────────────────────────────────────

/// Registro de cada execucao do cron.
///
/// Existe porque silencio e indistinguivel de sucesso: sem gravar, um cron que
/// morreu ha tres dias parece exatamente igual a um cron que rodou. E o
/// estrago e invisivel — ninguem recebe aviso de atraso, contrato recorrente
/// nao gera OS, coordenada nao e preenchida.
///
/// A rota /api/health le a ultima execucao bem-sucedida e devolve 503 quando
/// esta velha demais, que e o que faz o monitor externo alertar.
model CronRun {
  id         String    @id @default(cuid())
  /// Qual cron. Ha um so hoje ("daily"), mas nomear evita que o segundo
  /// precise de outra tabela.
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  /// Resumo do que foi feito, ou do que falhou. Texto curto: isto e sinal de
  /// saude, nao log de aplicacao.
  detail     String?

  // A consulta e sempre "a ultima execucao boa deste cron".
  @@index([name, ok, startedAt])
}

// ─── Escrita offline ─────────────────────────────────────────────────────────

/// Operacao vinda da fila offline do celular do tecnico.
///
/// Existe por UMA razao: idempotencia. A sincronizacao repete — a rede oscila,
/// o app reabre, a resposta se perde no caminho depois de o servidor ja ter
/// aplicado. Concluir a mesma OS duas vezes criaria DUAS receitas e baixaria o
/// estoque em DOBRO, e ninguem perceberia ate o financeiro nao fechar.
///
/// O id vem do CLIENTE (crypto.randomUUID) e e a chave primaria: se ja existe,
/// a operacao ja foi aplicada e a repeticao e ignorada. Guardar no servidor um
/// id gerado pelo cliente e seguro aqui porque ele so serve pra deduplicar
/// dentro do proprio tenant — nao concede nada.
model OfflineOperation {
  /// UUID gerado no celular.
  id        String   @id
  tenantId  String
  userId    String?
  type      String
  orderId   String?
  /// O que aconteceu: aplicada ou recusada, e por que. Guardado pra a tela do
  /// tecnico poder explicar, e pra diagnostico depois.
  outcome   String
  reason    String?
  /// Quando o TECNICO fez, nao quando sincronizou. Pode ser dias antes.
  clientAt  DateTime
  appliedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, appliedAt])
  @@index([orderId])
}

/// A reivindicacao de que um fato JA FOI AVISADO ao dono da plataforma.
///
/// A linha e criada ANTES do envio, e o indice unico da  e o que impede o
/// aviso repetido — nao um . As duas origens repetem por natureza: o
/// webhook do Asaas reenvia o mesmo evento, e o primeiro login tem corrida
/// conhecida entre Server Components.
model PlatformAlert {
  id        String   @id @default(cuid())
  /// novaEmpresa:<tenantId> · atraso:<subId>:<fimDoPeriodo> · cancelamento:<subId>
  /// Atraso e cancelamento tem chaves DIFERENTES: com uma chave por empresa, o
  /// cancelamento seria engolido pela linha do atraso, e o dono saberia que o
  /// cliente atrasou e nunca que ele foi embora.
  key       String   @unique
  event     String
  /// Sem chave estrangeira de proposito: o registro sobrevive ao apagar da
  /// empresa, pelo mesmo motivo do AdminAuditLog.
  tenantId  String?
  /// O corpo exato que saiu, para responder depois o que o aviso dizia.
  detail    String?
  /// Quantos aparelhos receberam. ZERO com a linha presente = o gatilho rodou e
  /// o push falhou; linha AUSENTE = o gatilho nunca rodou.
  delivered Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum SupportThreadStatus {
  ABERTA
  RESPONDIDA
  FECHADA
}

/// Quem falou. Dois lados so: a empresa cliente e a plataforma.
enum SupportAuthorKind {
  CLIENTE
  PLATAFORMA
}

/// Uma DUVIDA do cliente, e a conversa inteira sobre ela.
///
/// `tenantId` e `authorId` sao ANULAVEIS com SET NULL, e isso e deliberado:
/// a duvida de quem DESISTIU e a mais valiosa que existe — e o motivo do
/// abandono, escrito pela propria pessoa. Cascade apagaria justamente ela, e
/// Restrict impediria apagarEmpresaAbandonada() de funcionar.
///
/// Por isso a linha carrega o RETRATO do momento da pergunta: depois do
/// apagamento, e a unica memoria de que ela foi feita.
model SupportThread {
  id       String  @id @default(cuid())
  tenantId String?
  authorId String?

  /// O retrato. Guardado e nao lido ao vivo: "por que nao vejo o mapa?" so faz
  /// sentido junto do plano que a empresa TINHA quando perguntou.
  tenantName         String
  authorName         String
  authorEmail        String
  /// Cargo como texto: cargo pode sair do enum, e a linha antiga nao pode
  /// virar invalida por causa disso.
  authorRole         String
  planName           String?
  subscriptionStatus String

  /// A tela onde a pessoa estava, pela rota CANONICA do catalogo — nunca o
  /// caminho cru, para nao entrar id de cliente nem de OS no painel.
  screenRoute String?
  /// "1.1", para o dono reconhecer a tela de imediato.
  screenCode  String?

  status          SupportThreadStatus @default(ABERTA)
  messageCount    Int                 @default(0)
  lastMessageAt   DateTime
  lastMessageFrom SupportAuthorKind

  /// Quando o CLIENTE leu a ultima resposta. So do lado dele: no painel, "nao
  /// lida" e simplesmente status ABERTA.
  readByClientAt DateTime?

  closedAt  DateTime?
  /// E-mail de quem fechou, ou "cliente".
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  // A fila do painel: abertas primeiro, da mais recente para a mais velha.
  @@index([status, lastMessageAt])
  // A lista do cliente, e a contagem de abertas por empresa.
  @@index([tenantId, status])
}

model SupportMessage {
  id       String            @id @default(cuid())
  threadId String
  kind     SupportAuthorKind
  body     String
  /// Retrato tambem aqui: quem respondeu pode nao estar mais na equipe.
  authorName  String
  authorEmail String
  createdAt   DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
